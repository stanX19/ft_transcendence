APP_ENV=development

POSTGRES_DB=libraryos
POSTGRES_TEST_DB=libraryos_test
POSTGRES_USER=libraryos
POSTGRES_PASSWORD=libraryos_dev_password
DATABASE_URL=postgresql+psycopg://libraryos:libraryos_dev_password@db:5432/libraryos
TEST_DATABASE_URL=postgresql+psycopg://libraryos:libraryos_dev_password@db:5432/libraryos_test

AUTH_SECRET=replace_me_with_a_long_random_development_secret
AUTH_SESSION_HOURS=24
SESSION_COOKIE_NAME=libraryos_session

PUBLIC_API_KEY=replace_me_public_api_key
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60

GEMINI_API_KEY=
GEMINI_MODEL=

UPLOAD_MAX_MB=10
AI_RATE_LIMIT_PER_MINUTE=10
ONLINE_THRESHOLD_SECONDS=120
LOAN_DAYS=14
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
SEED_DEMO_DATA=true
